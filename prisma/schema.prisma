generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

/// Profil utilisateur spécifique à l'application, lié à l'ID Clerk
model UserProfile {
  clerkId    String   @id             // UUID généré par Clerk
  role       String                 
  bio        String?                
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt    
}

/// Logs de test en préproduction
model test_logs {
  id        String   @id @default(uuid())
  action    String   // Format: action_entity (ex: create_articles)
  details   String   // JSON.stringify des données
  timestamp DateTime @default(now())
  status    String   // pending, completed, error
  result_id String?  // ID du résultat si l'opération a réussi

  @@index([action, status])
}

/// Modèles de templates d'email
model EmailTemplate {
  id        String   @id @default(uuid())
  name      String
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Programmes disponibles
model Program {
  id        String   @id @default(uuid())
  name      String
  price     Float
  fileUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Achats effectués par les utilisateurs
model Purchase {
  id        String   @id @default(uuid())
  userId    String   // UUID Clerk stocké dans UserProfile
  programId String   // Référence au Program.id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
